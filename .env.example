# ── Azure OpenAI (우선 사용, 아래 3개 모두 입력 시 활성화)
AZURE_OPENAI_API_KEY=atl-여기에키입력
AZURE_OPENAI_ENDPOINT=https://aitalentlab.skax.co.kr:18081
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Anthropic (Azure 미설정 시 대체)
ANTHROPIC_API_KEY=sk-ant-여기에키입력

# ── 외부 API (선택)
UNIPASS_API_KEY=

# ── 경로
CHROMA_DB_PATH=./data/chroma_db
AUDIT_LOG_PATH=./logs/audit_log.json
